# BridalOS — نمونه متغیرهای محیطی (بدون مقدار محرمانه)
# هرگز فایل .env واقعی را در مخزن قرار ندهید.

# --- عمومی ---
NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info
TZ=Asia/Tehran

# --- API ---
API_PORT=4000
API_HOST=0.0.0.0
# مبدأهای مجاز CORS (با کاما جدا کنید). در preview باید دامنه اپ وب اضافه شود.
API_ORIGINS=http://localhost:3000

# --- دیتابیس ---
# driver: pglite (فقط local/dev/test) یا postgres (staging/production)
DB_DRIVER=pglite
PGLITE_DATA_DIR=.data/pglite
DATABASE_URL=postgresql://bridalos:change-me-locally@localhost:5432/bridalos
# نقش برنامه در production (بدون BYPASSRLS) — برای اعمال RLS
DATABASE_APP_ROLE=bridalos_app

# --- احراز هویت ---
# حداقل ۳۲ کاراکتر؛ در production اجباری و بدون این مقدار سرویس بالا نمی‌آید
AUTH_JWT_SECRET=
AUTH_JWT_TTL_SECONDS=1800
# فلفل هش کد یکبارمصرف — حداقل ۳۲ کاراکتر
AUTH_OTP_PEPPER=
AUTH_OTP_TTL_SECONDS=120
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_OTP_MAX_PER_HOUR=5
# فقط برای local/dev: کد OTP در پاسخ API برگردانده می‌شود تا امکان تست دستی باشد.
# در production مقدار false اجباری است (config validation جلوی true را می‌گیرد).
AUTH_DEV_ECHO_OTP=true

# --- پیامک (آداپتور) ---
# dev | kavenegar | ... (فعلاً فقط dev پیاده‌سازی شده است)
SMS_DRIVER=dev

# --- وب ---
WEB_PORT=3000
# آدرس داخلی API برای رندر سمت سرور و rewrite (سمت مرورگر نسبی است)
API_INTERNAL_URL=http://127.0.0.1:4000
NEXT_PUBLIC_APP_NAME=BridalOS

# --- سرویس AI ---
AI_SERVICE_PORT=8000
AI_PROVIDER=dev-watermark
# کلید واقعی ارائه‌دهنده AI (در صورت وجود) — هرگز در مخزن قرار نگیرد
AI_PROVIDER_API_KEY=

# --- ذخیره‌سازی رسانه ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_PRIVATE=bridalos-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_SIGNED_URL_TTL_SECONDS=300
