{
  "name": "@bridalos/api",
  "version": "0.1.0",
  "private": true,
  "description": "هسته تجاری BridalOS (modular monolith)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp -R src/database/migrations dist/database/",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/database/cli/migrate.ts",
    "db:seed:dev": "tsx src/database/cli/seed-dev.ts",
    "photos:sweep": "tsx src/database/cli/photos-sweep.ts"
  },
  "dependencies": {
    "@bridalos/contracts": "*",
    "@electric-sql/pglite": "^0.5.15",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/platform-express": "^12.4.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.4.0",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "type": "module"
}
